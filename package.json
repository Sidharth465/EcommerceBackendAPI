{
  "name": "e-com-backend",
  "version": "1.0.0",
  "main": "index.js",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.22.0",
    "npm": "please-use-yarn"
  },
  "scripts": {
    "preinstall": "npx only-allow yarn",
    "test": "echo \"Error: no test specified\" && exit 1",
    "nodemon:uat": "NODE_ENV=uat ts-node-dev --respawn --transpile-only src/server.ts",
    "nodemon:prod": "NODE_ENV=production ts-node-dev --respawn --transpile-only src/server.ts",
    "db:migrate:uat": "NODE_ENV=uat npx sequelize-cli db:migrate",
    "db:status:uat": "NODE_ENV=uat npx sequelize-cli db:migrate:status",
    "db:undo:uat": "NODE_ENV=uat npx sequelize-cli db:migrate:undo",
    "db:migrate:prod": "NODE_ENV=production npx sequelize-cli db:migrate",
    "db:status:prod": "NODE_ENV=production npx sequelize-cli db:migrate:status",
    "db:gen": "npx sequelize-cli migration:generate --name",
    "lint": "eslint . --max-warnings 10",
    "lint:strict": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prettier:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "check:lines": "node scripts/check-line-count.js",
    "check:package-manager": "node scripts/check-package-manager.js",
    "ci:check": "yarn check:lines && yarn prettier:check && yarn lint && yarn type-check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "pino": "^9.9.5",
    "pino-pretty": "^13.1.1",
    "sequelize": "^6.37.7",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.3",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "jiti": "^2.5.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "sequelize-cli": "^6.6.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
