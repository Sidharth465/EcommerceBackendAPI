NODE_ENV=local|uat|production
PORT=3000

# Postgres (local dev can use user/password/host/port/db)
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=

# Alternatively a single URL if you prefer
# DATABASE_URL=

# CORS
CORS_ALLOWED_ORIGINS=

# JWT Security
JWT_ACCESS_SECRET=replace_in_prod_access_secret
JWT_REFRESH_SECRET=replace_in_prod_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info
DB_SSL=false|true