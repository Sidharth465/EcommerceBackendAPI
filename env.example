NODE_ENV=local|uat|production
PORT=3000

# Postgres (local dev can use user/password/host/port/db)
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=

# Alternatively a single URL if you prefer
# DATABASE_URL=

# CORS
CORS_ALLOWED_ORIGINS=

# Security
JWT_SECRET=replace_in_prod
JWT_EXPIRES_IN=

# Logging
LOG_LEVEL=info
DB_SSL=false|true